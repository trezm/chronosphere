# Public origin used for OAuth callbacks and OpenRouter attribution.
# Local example: http://localhost:3000
# Railway example: https://chronosphere-production.up.railway.app
APP_URL=http://localhost:3000

# Register a GitHub OAuth App and use ${APP_URL}/api/auth/github/callback
# as its Authorization callback URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Any OpenRouter model ID. A reviewer can override this before each replay.
OPENROUTER_MODEL=openai/gpt-5-mini

# Optional two-stage AI review defaults. Both fall back to OPENROUTER_MODEL.
OPENROUTER_SCOUT_MODEL=
OPENROUTER_REVIEWER_MODEL=
